# Compose files live in infra/compose/. The agent overlay contains cloudflared;
# the headed stack is available as infra/compose/docker-compose.headed.yml.
# Get the token: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Install connector.
# Do not commit a real .env file (TUNNEL_TOKEN is a secret).
TUNNEL_TOKEN=

# Hostname (match Cloudflare public hostname) where only /v1, /v1beta, /models, /tmp are allowed — no web UI, no /api.
# Admin + SPA use a different hostname (e.g. admin-flow.prismacreative.online) without this var on that host.
# This host also allows /captcha_ws for extension mode and /api/cache/blob/... for generated files.
SUB2GEN_API_ONLY_HOST=flow-api.prismacreative.online

# Railway single-service deploy (extension mode)
# - Railway sets PORT automatically.
# - Mount a Railway volume at /app/storage; Railway then sets RAILWAY_VOLUME_MOUNT_PATH.
# - Use admin-flow.prismacreative.online for the admin UI and flow-api.prismacreative.online for API/cache/extension traffic.
SUB2GEN_ADMIN_USERNAME=admin
SUB2GEN_ADMIN_PASSWORD=change-me
SUB2GEN_API_KEY=change-me-api-key
SUB2GEN_CAPTCHA_METHOD=extension
SUB2GEN_CACHE_BASE_URL=https://flow-api.prismacreative.online

# Redis hot state. Railway should use ${{Redis.REDIS_URL}} for SUB2GEN_REDIS_URL.
# Start in shadow, initialize the state marker explicitly, then switch to required.
SUB2GEN_REDIS_URL=redis://redis:6379/0
SUB2GEN_REDIS_MODE=shadow
SUB2GEN_SQLITE_READ_POOL_SIZE=3
# Use ephemeral disk for migration/backup staging; never place multi-GB
# temporary archives on the production database volume.
SUB2GEN_TMP_DIR=
# Enable only after the pre-change Google Drive backup and maintenance compaction.
SUB2GEN_RETENTION_ENABLED=false

# Durable database bridge. Keep sqlite during the migration bridge, then switch
# to postgres only after the verified cutover marker has been written.
SUB2GEN_DATABASE_BACKEND=sqlite
SUB2GEN_DATABASE_URL=postgresql://sub2gen:sub2gen@postgres:5432/sub2gen
SUB2GEN_DB_SCHEMA=sub2gen
SUB2GEN_DB_POOL_MIN_SIZE=2
SUB2GEN_DB_POOL_MAX_SIZE=10
SUB2GEN_DB_POOL_TIMEOUT_SECONDS=5
SUB2GEN_DB_STATEMENT_TIMEOUT_SECONDS=30
SUB2GEN_REQUIRE_CUTOVER_MARKER=true

# Encrypted Google Drive PostgreSQL backups. Values in KEYS_JSON are base64
# encoded 32-byte AES-256 keys, for example {"2026-08":"..."}.
SUB2GEN_BACKUP_ACTIVE_KEY_ID=
SUB2GEN_BACKUP_KEYS_JSON={}
SUB2GEN_AUTO_RESTART_AFTER_RESTORE=true

# Optional DigitalOcean Spaces cache provider. Secrets stay in the environment;
# select DigitalOcean and proxy/CDN delivery from the admin Cache screen.
SUB2GEN_DO_SPACES_ACCESS_KEY_ID=
SUB2GEN_DO_SPACES_SECRET_ACCESS_KEY=
SUB2GEN_DO_SPACES_REGION=
SUB2GEN_DO_SPACES_BUCKET=
SUB2GEN_DO_SPACES_PREFIX=sub2gen/cache
SUB2GEN_FAILED_LOG_PREFIX=sub2gen/logs
SUB2GEN_DO_SPACES_CDN_BASE_URL=
# Required only for CDN mode so expiry/clear can purge edge-cached objects.
SUB2GEN_DO_API_TOKEN=
SUB2GEN_DO_CDN_ENDPOINT_ID=

# Optional private Google Drive backups. Create a Google OAuth "Web application"
# and register the exact callback URL shown below in Google Cloud Console.
SUB2GEN_GOOGLE_DRIVE_CLIENT_ID=
SUB2GEN_GOOGLE_DRIVE_CLIENT_SECRET=
SUB2GEN_GOOGLE_DRIVE_REDIRECT_URI=https://admin-flow.prismacreative.online/api/admin/backups/google-drive/oauth/callback
SUB2GEN_DEBUG_ENABLED=false
SUB2GEN_DEBUG_PAYLOAD_LOGGING=false
SUB2GEN_SYNC_DEBUG_LOGGING=false
# Optional debug detail toggles. Leave defaults unless you need very verbose logs.
# SUB2GEN_DEBUG_LOG_REQUESTS=true
# SUB2GEN_DEBUG_LOG_RESPONSES=true
# SUB2GEN_DEBUG_MASK_TOKEN=true
# SUB2GEN_DEBUG_RECAPTCHA_TRACE=false
# SUB2GEN_DEBUG_RECAPTCHA_CONSOLE=false
