# Copy to .env for automatic Compose interpolation, or pass explicitly:
#   cp .env.headed.example .env
#   docker compose --env-file .env.headed.example -f infra/compose/docker-compose.headed.yml up --build -d

# API on host (container app port comes from config/setting.toml, usually 8000)
FRONTEND_PORT=8000

# VNC: host port -> container x11vnc port
VNC_HOST_PORT=5900
VNC_PORT=5900
ENABLE_HEADED_VNC=true
# Leave empty for passwordless VNC (dev only). Set for production.
VNC_PASSWORD=

# noVNC: browser URL -> x11vnc
NOVNC_HOST_PORT=6080
NOVNC_PORT=6080
ENABLE_HEADED_NOVNC=true
# Optional full external URL for the admin "Open Fluxbox" button, e.g. Cloudflare Access hostname.
VITE_NOVNC_URL=

# Virtual framebuffer size (WxHxDepth)
XVFB_SCREEN=1920x1080x24

# Shared memory for Chromium (e.g. 1gb, 2gb)
SHM_SIZE=2gb

# Redis is hot state only; select sqlite during the bridge and postgres after cutover.
SUB2GEN_REDIS_URL=redis://redis:6379/0
SUB2GEN_REDIS_MODE=shadow
SUB2GEN_SQLITE_READ_POOL_SIZE=3
SUB2GEN_TMP_DIR=
SUB2GEN_RETENTION_ENABLED=false
SUB2GEN_DATABASE_BACKEND=sqlite
SUB2GEN_DATABASE_URL=postgresql://sub2gen:sub2gen@postgres:5432/sub2gen
SUB2GEN_DB_SCHEMA=sub2gen
SUB2GEN_DB_POOL_MIN_SIZE=2
SUB2GEN_DB_POOL_MAX_SIZE=10
SUB2GEN_DB_POOL_TIMEOUT_SECONDS=5
SUB2GEN_DB_STATEMENT_TIMEOUT_SECONDS=30
SUB2GEN_REQUIRE_CUTOVER_MARKER=true
SUB2GEN_BACKUP_ACTIVE_KEY_ID=
SUB2GEN_BACKUP_KEYS_JSON={}
SUB2GEN_AUTO_RESTART_AFTER_RESTORE=true

# Optional DigitalOcean Spaces cache provider.
SUB2GEN_DO_SPACES_ACCESS_KEY_ID=
SUB2GEN_DO_SPACES_SECRET_ACCESS_KEY=
SUB2GEN_DO_SPACES_REGION=
SUB2GEN_DO_SPACES_BUCKET=
SUB2GEN_DO_SPACES_PREFIX=sub2gen/cache
SUB2GEN_FAILED_LOG_PREFIX=sub2gen/logs
SUB2GEN_DO_SPACES_CDN_BASE_URL=
# Required only for Public CDN mode purge support.
SUB2GEN_DO_API_TOKEN=
SUB2GEN_DO_CDN_ENDPOINT_ID=

# Optional private Google Drive database + browser-profile backups.
SUB2GEN_GOOGLE_DRIVE_CLIENT_ID=
SUB2GEN_GOOGLE_DRIVE_CLIENT_SECRET=
SUB2GEN_GOOGLE_DRIVE_REDIRECT_URI=https://admin-flow.prismacreative.online/api/admin/backups/google-drive/oauth/callback
