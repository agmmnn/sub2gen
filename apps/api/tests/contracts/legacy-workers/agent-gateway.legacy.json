{
  "fixture_version": 1,
  "dialect": "agent_gateway.legacy-unversioned",
  "sources": [
    "apps/agent-gateway/src/sub2gen_gateway/ws_agents.py",
    "apps/agent-gateway/src/sub2gen_gateway/state.py",
    "apps/agent-gateway/src/sub2gen_gateway/schemas.py"
  ],
  "codec": {
    "encoding": "utf-8 JSON text frames",
    "path": "/ws/agents",
    "protocol_version_field": null,
    "correlation_field": "job_id",
    "first_worker_message": "register",
    "result_type_required": true,
    "heartbeat_response": {
      "type": "error",
      "detail": "unknown type 'ping'"
    }
  },
  "required_placeholders": [
    "<device-token>",
    "<agent-token>",
    "<agent-token-id>",
    "<agent-subject>",
    "<job-id>",
    "<captcha-token>",
    "<solve-session-id>",
    "<browser-user-agent>",
    "<browser-language>"
  ],
  "scenarios": [
    {
      "name": "register_legacy_shared_secret",
      "frames": [
        {
          "direction": "worker_to_server",
          "message": {
            "type": "register",
            "device_token": "<device-token>",
            "agent_id": "contract-agent"
          }
        },
        {
          "direction": "server_to_worker",
          "message": {
            "type": "registered",
            "subject": "legacy-shared-token",
            "auth_method": "legacy"
          }
        }
      ]
    },
    {
      "name": "register_keygen_agent",
      "frames": [
        {
          "direction": "worker_to_server",
          "message": {
            "type": "register",
            "agent_token": "<agent-token>",
            "agent_token_id": "<agent-token-id>",
            "agent_id": "contract-agent"
          }
        },
        {
          "direction": "server_to_worker",
          "message": {
            "type": "registered",
            "subject": "<agent-subject>",
            "auth_method": "keygen"
          }
        }
      ]
    },
    {
      "name": "solve_success",
      "frames": [
        {
          "direction": "server_to_worker",
          "message": {
            "type": "solve_job",
            "job_id": "<job-id>",
            "project_id": "project-contract-001",
            "action": "IMAGE_GENERATION"
          }
        },
        {
          "direction": "worker_to_server",
          "message": {
            "type": "solve_result",
            "job_id": "<job-id>",
            "token": "<captcha-token>",
            "session_id": "<solve-session-id>",
            "fingerprint": {
              "user_agent": "<browser-user-agent>",
              "language": "<browser-language>"
            }
          }
        }
      ]
    },
    {
      "name": "solve_error",
      "frames": [
        {
          "direction": "server_to_worker",
          "message": {
            "type": "solve_job",
            "job_id": "<job-id>",
            "project_id": "project-contract-002",
            "action": "VIDEO_GENERATION"
          }
        },
        {
          "direction": "worker_to_server",
          "message": {
            "type": "solve_error",
            "job_id": "<job-id>",
            "error": "recaptcha_execution_failed"
          }
        }
      ]
    },
    {
      "name": "heartbeat_ping_rejected",
      "frames": [
        {
          "direction": "worker_to_server",
          "message": {
            "type": "ping"
          }
        },
        {
          "direction": "server_to_worker",
          "message": {
            "type": "error",
            "detail": "unknown type 'ping'"
          }
        }
      ]
    }
  ]
}
